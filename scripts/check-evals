#!/usr/bin/env python3
"""Validate checked-in alignment eval evidence and replay thin-gate fixtures."""

import json
import re
import shutil
import sys
import tempfile
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from epistemic_alignment.approval import check_gate, issue_review, record_decision
from epistemic_alignment.handoff import write_handoff
from epistemic_alignment.snapshot import create_snapshot


NAMES = {
    "greenfield",
    "existing-repo",
    "conflict",
    "critical-unknown",
    "bounded-skip",
    "stale-approval",
    "self-approval",
}
KINDS = {
    "greenfield": "dossier-run",
    "existing-repo": "dossier-run",
    "conflict": "dossier-run",
    "critical-unknown": "dossier-run",
    "bounded-skip": "bounded-skip-run",
    "stale-approval": "deterministic-fixture",
    "self-approval": "deterministic-fixture",
}
DOSSIER_CASES = {"greenfield", "existing-repo", "conflict", "critical-unknown"}
SITE_KEYS = {
    "project", "summary", "stakeholders", "useCases", "behavior",
    "architecture", "decisions", "risks", "findings", "snapshot",
}
RUN_KEYS = {
    "schema_version", "case", "captured_output", "evidence_files",
    "site_reference", "gate", "gate_reasons", "approval_recorded",
    "handoff_created", "published",
}
IGNORED_EVIDENCE_DIRS = {
    ".next", ".vinext", ".wrangler", "coverage", "dist", "node_modules",
}


def fail(message: str) -> None:
    raise ValueError(message)


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"invalid JSON at {path}: {error}")


def require_strings(value: Any, name: str) -> List[str]:
    if not isinstance(value, list) or not value or not all(isinstance(item, str) and item for item in value):
        fail(f"{name} must be a non-empty list of strings")
    return value


def local_file(base: Path, reference: str, label: str) -> Path:
    if not isinstance(reference, str) or not reference:
        fail(f"{label} must be a non-empty local path")
    raw_path = reference.split("#", 1)[0]
    candidate = Path(raw_path)
    if candidate.is_absolute():
        resolved = candidate.resolve()
    else:
        if ".." in candidate.parts:
            fail(f"{label} escapes its evidence directory")
        resolved = (base / candidate).resolve()
    try:
        resolved.relative_to(ROOT.resolve())
    except ValueError:
        fail(f"{label} escapes the repository")
    if not resolved.is_file():
        fail(f"{label} is missing: {reference}")
    return resolved


def expected_for(name: str) -> Tuple[List[str], List[str], str]:
    expected = load_json(ROOT / "evals/expected" / f"{name}.json")
    required = require_strings(expected.get("required"), f"{name}.required")
    forbidden = require_strings(expected.get("forbidden"), f"{name}.forbidden")
    gate = expected.get("gate")
    if gate not in {"approved", "blocked", "skipped", "invalidated"}:
        fail(f"{name}.gate is unsupported")
    return required, forbidden, gate


def assert_phrases(name: str, required: List[str], forbidden: List[str], text: str) -> None:
    normalized = text.lower()
    for phrase in required:
        if phrase.lower() not in normalized:
            fail(f"{name} captured output is missing required assertion: {phrase}")
    for phrase in forbidden:
        if phrase.lower() in normalized:
            fail(f"{name} contains forbidden claim: {phrase}")


def scoped_run_texts(name: str, run_dir: Path) -> List[str]:
    """Read authored run evidence while excluding dependency/build output."""
    texts = []
    for path in sorted(run_dir.rglob("*")):
        relative = path.relative_to(run_dir)
        if not path.is_file() or any(part in IGNORED_EVIDENCE_DIRS for part in relative.parts):
            continue
        try:
            texts.append(path.read_text(encoding="utf-8"))
        except UnicodeDecodeError as error:
            raise ValueError(f"{name} scoped evidence is not valid UTF-8: {relative}") from error
    return texts


EVENT_KEYS = {
    "request": {"id", "role", "type", "evidence", "body"},
    "human-answer": {"id", "role", "type", "evidence", "body"},
    "command": {"id", "role", "type", "evidence", "action_id", "operation", "argv"},
    "command-result": {"id", "role", "type", "evidence", "action_id", "exit_code", "output"},
    "artifact": {"id", "role", "type", "evidence", "artifact_type", "path"},
    "qualification": {"id", "role", "type", "evidence", "body"},
    "outcome": {"id", "role", "type", "evidence", "body"},
}
EVENT_ROLES = {
    "request": "human", "human-answer": "human", "command": "agent",
    "command-result": "tool", "artifact": "agent", "qualification": "agent",
    "outcome": "agent",
}
DOSSIER_EVENT_TYPES = [
    "request", "human-answer", "command", "command-result", "command",
    "command-result", "artifact", "command", "command-result", "command",
    "command-result", "outcome",
]
DOSSIER_OPERATIONS = ["init", "snapshot", "issue-review", "check-gate"]


def transcript_events(name: str, text: str) -> List[Dict[str, Any]]:
    """Decode the explicit mechanical event schema embedded in Markdown."""
    if not re.search(r"^# .+transcript\s*$", text, re.MULTILINE | re.IGNORECASE):
        fail(f"{name} transcript event schema requires a transcript heading")
    blocks = re.findall(r"```json-event\s*\n(.*?)\n```", text, re.DOTALL)
    if not blocks:
        fail(f"{name} transcript event schema has no json-event records")
    events: List[Dict[str, Any]] = []
    for index, block in enumerate(blocks, start=1):
        try:
            event = json.loads(block)
        except json.JSONDecodeError as error:
            fail(f"{name} transcript event schema record E{index:03d} is invalid JSON: {error}")
        if not isinstance(event, dict):
            fail(f"{name} transcript event schema record E{index:03d} is not an object")
        event_type = event.get("type")
        if event_type not in EVENT_KEYS or set(event) != EVENT_KEYS[event_type]:
            fail(f"{name} transcript event schema record E{index:03d} has invalid fields")
        if event.get("id") != f"E{index:03d}" or event.get("role") != EVENT_ROLES[event_type]:
            fail(f"{name} transcript event schema record E{index:03d} has invalid identity or role")
        evidence = event.get("evidence")
        if not isinstance(evidence, list) or not all(isinstance(item, str) and item for item in evidence):
            fail(f"{name} transcript event schema record E{index:03d} has invalid evidence")
        for field in ("body", "path", "artifact_type"):
            if field in event and (not isinstance(event[field], str) or not event[field].strip()):
                fail(f"{name} transcript event schema record E{index:03d} has empty {field}")
        events.append(event)
    return events


def validate_transcript(name: str, run_dir: Path, text: str,
                        evidence_files: List[str], site_reference: Optional[str],
                        snapshot: Optional[Any] = None,
                        actual_gate: Optional[Any] = None) -> None:
    """Verify interaction mechanics without judging dossier semantics."""
    events = transcript_events(name, text)
    if name == "bounded-skip":
        expected = ["request", "qualification", "human-answer", "outcome"]
        if [event["type"] for event in events] != expected:
            fail(f"{name} transcript event schema must record request, qualification, human answer, and outcome")
        for event in events:
            for reference in event["evidence"]:
                local_file(run_dir, reference, f"{name} transcript evidence")
        return

    if [event["type"] for event in events] != DOSSIER_EVENT_TYPES:
        fail(f"{name} transcript event schema has an invalid dossier event sequence")
    commands = [event for event in events if event["type"] == "command"]
    if [event.get("operation") for event in commands] != DOSSIER_OPERATIONS:
        fail(f"{name} transcript event schema has an invalid operation sequence")
    if [event.get("action_id") for event in commands] != ["A001", "A002", "A003", "A004"]:
        fail(f"{name} transcript event schema has invalid action identities")
    for event in events:
        for reference in event["evidence"]:
            if reference not in evidence_files:
                fail(f"{name} transcript evidence is not declared by the run: {reference}")
            local_file(run_dir, reference, f"{name} transcript evidence")
    for command in commands:
        argv = command.get("argv")
        operation = command["operation"]
        cli_operation = "check" if operation == "check-gate" else operation
        if (not isinstance(command.get("action_id"), str)
                or not re.fullmatch(r"A\d{3}", command["action_id"])
                or not isinstance(argv, list) or len(argv) < 3
                or not all(isinstance(arg, str) and arg for arg in argv)
                or Path(argv[0]).name != "alignment" or argv[1] != cli_operation
                or argv[2] != "<run-dir>"):
            fail(f"{name} transcript event schema has an invalid {operation} command")
    results = [event for event in events if event["type"] == "command-result"]
    for command, result in zip(commands, results):
        if (result.get("action_id") != command["action_id"]
                or not isinstance(result.get("exit_code"), int)
                or not isinstance(result.get("output"), dict) or not result["output"]):
            fail(f"{name} transcript event schema has an unpaired command result")
    if [result["exit_code"] for result in results] != [0, 0, 0, 1]:
        fail(f"{name} transcript event schema has invalid command exit codes")
    artifact = next(event for event in events if event["type"] == "artifact")
    site_path = site_reference.split("#", 1)[0] if isinstance(site_reference, str) else None
    if (artifact["artifact_type"] != "review-surface" or artifact["path"] != site_path
            or artifact["evidence"] != [site_path]):
        fail(f"{name} transcript event schema does not bind the review surface")
    if snapshot is None or actual_gate is None:
        fail(f"{name} transcript event schema was not checked against the run")
    snapshot_output = results[1]["output"]
    gate_output = results[3]["output"]
    if snapshot_output != {"algorithm": snapshot.algorithm, "digest": snapshot.digest, "paths": snapshot.paths}:
        fail(f"{name} transcript snapshot result does not match the current dossier")
    if results[2]["output"] != {"algorithm": "sha256-v1", "digest": snapshot.digest}:
        fail(f"{name} transcript issue-review result does not match the current dossier")
    expected_gate = {"digest": actual_gate.digest, "ready": actual_gate.ready, "reasons": actual_gate.reasons}
    if gate_output != expected_gate:
        fail(f"{name} transcript gate result does not match the helper replay")


def fixture_dossier(directory: str) -> Path:
    target = Path(directory) / "alignment"
    shutil.copytree(ROOT / "templates/alignment", target)
    return target


def replay_stale_approval() -> str:
    with tempfile.TemporaryDirectory(prefix="alignment-eval-stale-") as directory:
        target = fixture_dossier(directory)
        issued = issue_review(target, "eval-fixture", "presented", "site://eval-presented")
        record_decision(target, "approved", "eval-human", "human-message", issued.digest, [])
        (target / "review.md").write_text("edited after approval\n", encoding="utf-8")
        gate = check_gate(target)
        if gate.ready or not {"stale-approval", "hash-mismatch"}.issubset(set(gate.reasons)):
            fail("stale-approval fixture did not fail through the thin gate")
        try:
            write_handoff(target)
        except ValueError:
            return "fresh copy; stale-approval; matching hash-mismatch; refuse handoff"
        fail("stale-approval fixture wrote a handoff")


def replay_self_approval() -> str:
    with tempfile.TemporaryDirectory(prefix="alignment-eval-self-") as directory:
        target = fixture_dossier(directory)
        issued = issue_review(target, "eval-fixture", "presented", "site://eval-presented")
        try:
            record_decision(
                target, "approved", "eval-agent", "agent-inference", issued.digest, []
            )
        except ValueError as error:
            if "human-message provenance" not in str(error):
                fail(f"self-approval fixture failed for the wrong reason: {error}")
        else:
            fail("self-approval fixture accepted agent provenance")
        if check_gate(target).ready:
            fail("self-approval fixture left the gate ready")
        return "fresh copy; No current approval; helper rejects; leave the gate not ready"


def validate_common_record(name: str, run_dir: Path, record: Dict[str, Any]) -> Tuple[List[str], List[str]]:
    if set(record) != RUN_KEYS:
        fail(f"{name} result schema must contain exactly the normalized run fields")
    if record.get("schema_version") != "1.0" or record.get("case") != name:
        fail(f"{name} result identity is invalid")
    captured = require_strings(record.get("captured_output"), f"{name}.captured_output")
    evidence = require_strings(record.get("evidence_files"), f"{name}.evidence_files")
    if not isinstance(record.get("gate_reasons"), list) or not all(isinstance(reason, str) for reason in record["gate_reasons"]):
        fail(f"{name}.gate_reasons must be a string list")
    if any(record.get(field) is not False for field in ("approval_recorded", "handoff_created", "published")):
        fail(f"{name} cannot claim approval, handoff, or publication")
    texts = [json.dumps(record, ensure_ascii=False, sort_keys=True)]
    for reference in evidence:
        path = local_file(run_dir, reference, f"{name} evidence")
        try:
            texts.append(path.read_text(encoding="utf-8"))
        except UnicodeDecodeError as error:
            raise ValueError(f"{name} evidence is not valid UTF-8: {reference}") from error
    return captured, texts


def validate_dossier_run(name: str, run_dir: Path, record: Dict[str, Any], gate: str) -> None:
    captured, texts = validate_common_record(name, run_dir, record)
    if record.get("gate") != gate:
        fail(f"{name} captured gate does not match expected gate")
    for required_file in ("transcript.md", "alignment/manifest.yaml", "alignment/review.md", "alignment/review-state.json"):
        if required_file not in record["evidence_files"]:
            fail(f"{name} does not list required evidence: {required_file}")
    transcript = local_file(run_dir, "transcript.md", f"{name} transcript")
    site_reference = record.get("site_reference")
    site_path = local_file(run_dir, site_reference, f"{name} Site reference")
    site = load_json(site_path)
    if not isinstance(site, dict) or set(site) != SITE_KEYS:
        fail(f"{name} Site payload keys are not exact")
    alignment = run_dir / "alignment"
    if not alignment.is_dir():
        fail(f"{name} dossier is missing")
    snapshot = create_snapshot(alignment)
    required_evidence = {
        "transcript.md",
        "alignment/manifest.yaml",
        "alignment/review-state.json",
        site_reference.split("#", 1)[0],
        *(f"alignment/{path}" for path in snapshot.paths),
    }
    missing_evidence = sorted(required_evidence - set(record["evidence_files"]))
    if missing_evidence:
        fail(f"{name} omits current dossier or Site evidence: {', '.join(missing_evidence)}")
    state = load_json(alignment / "review-state.json")
    if not isinstance(state, dict):
        fail(f"{name} review state is invalid")
    state_snapshot = state.get("snapshot")
    presentation = state.get("presentation")
    if not isinstance(state_snapshot, dict) or not isinstance(presentation, dict):
        fail(f"{name} review state has no issued presentation")
    site_snapshot = site.get("snapshot")
    if not isinstance(site_snapshot, dict):
        fail(f"{name} Site has no snapshot")
    if not (
        site_snapshot.get("algorithm") == snapshot.algorithm
        and site_snapshot.get("digest") == snapshot.digest
        and site_snapshot.get("paths") == snapshot.paths
        and state_snapshot.get("algorithm") == snapshot.algorithm
        and state_snapshot.get("digest") == snapshot.digest
        and state_snapshot.get("paths") == snapshot.paths
        and presentation.get("rendered_hash") == snapshot.digest
    ):
        fail(f"{name} Site, issued snapshot, rendered hash, and dossier snapshot diverge")
    actual_gate = check_gate(alignment)
    if actual_gate.ready or gate != "blocked" or record["gate_reasons"] != actual_gate.reasons:
        fail(f"{name} claimed gate does not match the current helper gate")
    validate_transcript(
        name, run_dir, transcript.read_text(encoding="utf-8"),
        record["evidence_files"], site_reference, snapshot, actual_gate,
    )
    required, forbidden, expected_gate = expected_for(name)
    if expected_gate != gate:
        fail(f"{name} expected gate does not match run gate")
    assert_phrases(name, required, forbidden, "\n".join(captured))
    assert_phrases(name, [], forbidden, "\n".join(texts + scoped_run_texts(name, run_dir)))


def validate_bounded_skip(run_dir: Path, record: Dict[str, Any], gate: str) -> None:
    name = "bounded-skip"
    captured, texts = validate_common_record(name, run_dir, record)
    if record.get("gate") != gate or record.get("site_reference") is not None:
        fail("bounded-skip must report skipped with no Site reference")
    if set(record["evidence_files"]) != {"transcript.md"}:
        fail("bounded-skip must use its explicit transcript as the only evidence")
    transcript = local_file(run_dir, "transcript.md", "bounded-skip transcript")
    validate_transcript(
        name, run_dir, transcript.read_text(encoding="utf-8"),
        record["evidence_files"], None,
    )
    if (run_dir / "alignment").exists() or (run_dir / "alignment-review").exists() or list(run_dir.rglob("handoff.md")):
        fail("bounded-skip must not create a dossier, Site, or handoff")
    required, forbidden, expected_gate = expected_for(name)
    if expected_gate != gate:
        fail("bounded-skip expected gate does not match run gate")
    assert_phrases(name, required, forbidden, "\n".join(captured))
    assert_phrases(name, [], forbidden, "\n".join(texts + scoped_run_texts(name, run_dir)))


def validate_entry(entry: Dict[str, Any]) -> None:
    name = entry.get("name")
    if name not in NAMES or entry.get("kind") != KINDS[name]:
        fail("results contains an arbitrary case kind or name")
    if name in DOSSIER_CASES or name == "bounded-skip":
        if set(entry) != {"name", "kind", "result"}:
            fail(f"{name} must have exactly one run-result reference")
        result_path = local_file(ROOT, entry["result"], f"{name} result")
        run_dir = result_path.parent
        record = load_json(result_path)
        if not isinstance(record, dict):
            fail(f"{name} result record must be an object")
        _, _, gate = expected_for(name)
        if name in DOSSIER_CASES:
            validate_dossier_run(name, run_dir, record, gate)
        else:
            validate_bounded_skip(run_dir, record, gate)
        return
    if set(entry) != {"name", "kind"}:
        fail(f"{name} fixture entry has unexpected fields")
    required, forbidden, gate = expected_for(name)
    fixture_output = replay_stale_approval() if name == "stale-approval" else replay_self_approval()
    assert_phrases(name, required, forbidden, fixture_output)
    if (name == "stale-approval" and gate != "invalidated") or (name == "self-approval" and gate != "blocked"):
        fail(f"{name} expected gate is invalid")


def main(argv: List[str]) -> int:
    if len(argv) != 2:
        print("usage: scripts/check-evals artifacts/evals/results.json", file=sys.stderr)
        return 2
    results_path = local_file(ROOT, argv[1], "results")
    results = load_json(results_path)
    if not isinstance(results, dict) or set(results) != {"schema_version", "cases"} or results.get("schema_version") != "1.0":
        fail("unsupported eval results schema")
    cases = results.get("cases")
    if not isinstance(cases, list) or len(cases) != len(NAMES) or not all(isinstance(entry, dict) for entry in cases):
        fail("results must contain exactly seven object entries")
    by_name = {entry.get("name"): entry for entry in cases}
    if set(by_name) != NAMES:
        fail("results must contain exactly the seven named cases")
    if {path.stem for path in (ROOT / "evals/cases").glob("*.md")} != NAMES:
        fail("case corpus must contain exactly the seven named cases")
    if {path.stem for path in (ROOT / "evals/expected").glob("*.json")} != NAMES:
        fail("expected corpus must contain exactly the seven named assertions")
    for name in sorted(NAMES):
        validate_entry(by_name[name])
    print("7 cases passed (5 checked-in run records verified; 2 thin-gate fixtures replayed)")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except ValueError as error:
        print(f"check-evals: {error}", file=sys.stderr)
        raise SystemExit(1)
